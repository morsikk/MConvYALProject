{
  "meta": {
    "dots": 6,
    "name": "Русский (6-точечный)",
    "system": "Шеститочечный, ГОСТ Р 58511-2019",
    "dot_index_base": 0,
    "note": "точка 1 -> 0, точка 2 -> 1, точка 3 -> 2, точка 4 -> 3, точка 5 -> 4, точка 6 -> 5"
  },
  "prefixes": {
    "num_prefix": { "char": "⠼", "dots": [2, 3, 4, 5], "description": "числовой знак (цифровой индикатор)" },
    "capital_prefix": { "char": "⠘", "dots": [3, 4], "description": "признак заглавной (прописной) буквы" },
    "capital_word_prefix": { "char": "⠘⠘", "dots": [3, 4, 3, 4], "description": "признак слова, написанного заглавными буквами" }
  },
  "letters": {
    "А": { "char": "⠁", "dots": [0] },
    "Б": { "char": "⠃", "dots": [0, 1] },
    "В": { "char": "⠺", "dots": [1, 3, 4, 5] },
    "Г": { "char": "⠛", "dots": [0, 1, 3, 4] },
    "Д": { "char": "⠙", "dots": [0, 3, 4] },
    "Е": { "char": "⠑", "dots": [0, 4] },
    "Ё": { "char": "⠡", "dots": [0, 4, 5] },
    "Ж": { "char": "⠚", "dots": [1, 3, 4] },
    "З": { "char": "⠵", "dots": [0, 2, 4, 5] },
    "И": { "char": "⠊", "dots": [1, 3] },
    "Й": { "char": "⠯", "dots": [0, 1, 2, 3, 5] },
    "К": { "char": "⠅", "dots": [0, 2] },
    "Л": { "char": "⠇", "dots": [0, 1, 2] },
    "М": { "char": "⠍", "dots": [0, 2, 3] },
    "Н": { "char": "⠝", "dots": [0, 2, 3, 4] },
    "О": { "char": "⠕", "dots": [0, 2, 4] },
    "П": { "char": "⠏", "dots": [0, 1, 2, 3] },
    "Р": { "char": "⠗", "dots": [0, 1, 2, 4] },
    "С": { "char": "⠎", "dots": [1, 2, 3] },
    "Т": { "char": "⠞", "dots": [1, 2, 3, 4] },
    "У": { "char": "⠥", "dots": [0, 2, 5] },
    "Ф": { "char": "⠋", "dots": [0, 1, 3] },
    "Х": { "char": "⠓", "dots": [0, 1, 4] },
    "Ц": { "char": "⠉", "dots": [0, 3] },
    "Ч": { "char": "⠟", "dots": [0, 1, 2, 3, 4] },
    "Ш": { "char": "⠱", "dots": [1, 4, 5] },
    "Щ": { "char": "⠭", "dots": [0, 2, 3, 5] },
    "Ъ": { "char": "⠷", "dots": [1, 2, 3, 4, 5] },
    "Ы": { "char": "⠮", "dots": [1, 2, 3, 5] },
    "Ь": { "char": "⠾", "dots": [1, 2, 3, 4, 5, 6] },
    "Э": { "char": "⠪", "dots": [1, 3, 5] },
    "Ю": { "char": "⠳", "dots": [1, 2, 5, 6] },
    "Я": { "char": "⠫", "dots": [1, 3, 4, 6] }
  },
  "digits": {
    "1": { "char": "⠁", "dots": [0] },
    "2": { "char": "⠃", "dots": [0, 1] },
    "3": { "char": "⠉", "dots": [0, 3] },
    "4": { "char": "⠙", "dots": [0, 3, 4] },
    "5": { "char": "⠑", "dots": [0, 4] },
    "6": { "char": "⠋", "dots": [0, 1, 3] },
    "7": { "char": "⠛", "dots": [0, 1, 3, 4] },
    "8": { "char": "⠓", "dots": [0, 1, 4] },
    "9": { "char": "⠊", "dots": [1, 3] },
    "0": { "char": "⠚", "dots": [1, 3, 4] }
  },
  "punctuation": {
    ".": { "char": "⠲", "dots": [1, 4, 5], "description": "точка" },
    ",": { "char": "⠂", "dots": [1], "description": "запятая" },
    "?": { "char": "⠦", "dots": [1, 2, 5], "description": "вопросительный знак" },
    "!": { "char": "⠖", "dots": [1, 2, 4], "description": "восклицательный знак" },
    ":": { "char": "⠒", "dots": [1, 4], "description": "двоеточие" },
    ";": { "char": "⠆", "dots": [1, 2], "description": "точка с запятой" },
    "-": { "char": "⠤", "dots": [2, 5], "description": "дефис" },
    "—": { "char": "⠠⠤", "dots": [5, 2, 5], "description": "длинное тире (em dash)" },
    "'": { "char": "⠄", "dots": [2], "description": "апостроф" },
    "«": { "char": "⠦", "dots": [1, 2, 5], "description": "открывающая кавычка «ёлочка»" },
    "»": { "char": "⠴", "dots": [2, 3, 4], "description": "закрывающая кавычка «ёлочка»" },
    "(": { "char": "⠣", "dots": [1, 2, 6], "description": "открывающая круглая скобка" },
    ")": { "char": "⠜", "dots": [3, 4, 5], "description": "закрывающая круглая скобка" },
    "[": { "char": "⠯", "dots": [1, 2, 3, 4, 6], "description": "открывающая квадратная скобка" },
    "]": { "char": "⠼", "dots": [2, 3, 4, 5, 6], "description": "закрывающая квадратная скобка" },
    "…": { "char": "⠄⠄⠄", "dots": [2, 2, 2], "description": "многоточие" }
  },
  "math": {
    "+": { "char": "⠬", "dots": [2, 3, 4, 6], "description": "знак плюс" },
    "-": { "char": "⠤", "dots": [2, 5], "description": "знак минус" },
    "=": { "char": "⠶", "dots": [1, 2, 3, 5, 6], "description": "знак равенства" },
    "/": { "char": "⠸⠌", "dots": [3, 4, 5, 3, 4], "description": "косая черта (дробная черта)" },
    "%": { "char": "⠨⠴", "dots": [3, 5, 2, 3, 4], "description": "знак процента" },
    "@": { "char": "⠈⠁", "dots": [3, 0], "description": "коммерческое «эт» (@)" },
    "_": { "char": "⠨⠤", "dots": [3, 5, 2, 5], "description": "знак подчёркивания" },
    "×": { "char": "⠐⠦", "dots": [4, 1, 2, 5], "description": "знак умножения (точка)" },
    "÷": { "char": "⠐⠲", "dots": [4, 1, 4, 5], "description": "знак деления" }
  }
}