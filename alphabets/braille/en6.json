{
  "meta": {
    "dots": 6,
    "name": "Английский (6-точечный)",
    "system": "UEB (Единый английский шрифт Брайля) Уровня 1 (без сокращений)",
    "dot_index_base": 0,
    "note": "точка 1 -> 0, точка 2 -> 1, точка 3 -> 2, точка 4 -> 3, точка 5 -> 4, точка 6 -> 5"
  },
  "prefixes": {
    "num_prefix": { "char": "⠼", "dots": [2, 3, 4, 5], "description": "числовой индикатор (UEB)" },
    "capital_prefix": { "char": "⠠", "dots": [5], "description": "индикатор заглавной буквы" },
    "capital_word_prefix": { "char": "⠠⠠", "dots": [5, 5], "description": "индикатор слова с заглавной буквы" },
    "grade1_symbol": { "char": "⠰", "dots": [4, 5], "description": "индикатор символа Уровня 1 (точки 56)" }
  },
  "letters": {
    "A": { "char": "⠁", "dots": [0] },
    "B": { "char": "⠃", "dots": [0, 1] },
    "C": { "char": "⠉", "dots": [0, 3] },
    "D": { "char": "⠙", "dots": [0, 3, 4] },
    "E": { "char": "⠑", "dots": [0, 4] },
    "F": { "char": "⠋", "dots": [0, 1, 3] },
    "G": { "char": "⠛", "dots": [0, 1, 3, 4] },
    "H": { "char": "⠓", "dots": [0, 1, 4] },
    "I": { "char": "⠊", "dots": [1, 3] },
    "J": { "char": "⠚", "dots": [1, 3, 4] },
    "K": { "char": "⠅", "dots": [0, 2] },
    "L": { "char": "⠇", "dots": [0, 1, 2] },
    "M": { "char": "⠍", "dots": [0, 2, 3] },
    "N": { "char": "⠝", "dots": [0, 2, 3, 4] },
    "O": { "char": "⠕", "dots": [0, 2, 4] },
    "P": { "char": "⠏", "dots": [0, 1, 2, 3] },
    "Q": { "char": "⠟", "dots": [0, 1, 2, 3, 4] },
    "R": { "char": "⠗", "dots": [0, 1, 2, 4] },
    "S": { "char": "⠎", "dots": [1, 2, 3] },
    "T": { "char": "⠞", "dots": [1, 2, 3, 4] },
    "U": { "char": "⠥", "dots": [0, 2, 5] },
    "V": { "char": "⠧", "dots": [0, 1, 2, 5] },
    "W": { "char": "⠺", "dots": [1, 3, 4, 5] },
    "X": { "char": "⠭", "dots": [0, 2, 3, 5] },
    "Y": { "char": "⠽", "dots": [0, 2, 3, 4, 5] },
    "Z": { "char": "⠵", "dots": [0, 2, 4, 5] }
  },
  "digits": {
    "1": { "char": "⠁", "dots": [0] },
    "2": { "char": "⠃", "dots": [0, 1] },
    "3": { "char": "⠉", "dots": [0, 3] },
    "4": { "char": "⠙", "dots": [0, 3, 4] },
    "5": { "char": "⠑", "dots": [0, 4] },
    "6": { "char": "⠋", "dots": [0, 1, 3] },
    "7": { "char": "⠛", "dots": [0, 1, 3, 4] },
    "8": { "char": "⠓", "dots": [0, 1, 4] },
    "9": { "char": "⠊", "dots": [1, 3] },
    "0": { "char": "⠚", "dots": [1, 3, 4] }
  },
  "punctuation": {
    ".": { "char": "⠲", "dots": [1, 4, 5] },
    ",": { "char": "⠂", "dots": [1] },
    "?": { "char": "⠦", "dots": [1, 2, 5] },
    "!": { "char": "⠖", "dots": [1, 2, 4] },
    ":": { "char": "⠒", "dots": [1, 4] },
    ";": { "char": "⠆", "dots": [1, 2] },
    "-": { "char": "⠤", "dots": [2, 5] },
    "'": { "char": "⠄", "dots": [2], "description": "апостроф / ненаправленная одинарная кавычка" },
    "\"": { "char": "⠦", "dots": [1, 2, 5], "description": "открывающая двойная кавычка (или ненаправленная)" },
    "”": { "char": "⠴", "dots": [2, 3, 4], "description": "закрывающая двойная кавычка" },
    "“": { "char": "⠦", "dots": [1, 2, 5], "description": "открывающая двойная кавычка" },
    "‘": { "char": "⠄", "dots": [2], "description": "открывающая одинарная кавычка" },
    "’": { "char": "⠄", "dots": [2], "description": "закрывающая одинарная кавычка / апостроф" },
    "(": { "char": "⠐⠣", "dots": [4, 1, 2, 5], "description": "открывающая круглая скобка" },
    ")": { "char": "⠐⠜", "dots": [4, 3, 4, 5], "description": "закрывающая круглая скобка" },
    "[": { "char": "⠨⠣", "dots": [3, 5, 1, 2, 5], "description": "открывающая квадратная скобка" },
    "]": { "char": "⠨⠜", "dots": [3, 5, 3, 4, 5], "description": "закрывающая квадратная скобка" },
    "{": { "char": "⠸⠣", "dots": [3, 4, 5, 1, 2, 5], "description": "открывающая фигурная скобка" },
    "}": { "char": "⠸⠜", "dots": [3, 4, 5, 3, 4, 5], "description": "закрывающая фигурная скобка" },
    "—": { "char": "⠠⠤", "dots": [5, 2, 5], "description": "длинное тире (em dash)" },
    "...": { "char": "⠄⠄⠄", "dots": [2, 2, 2], "description": "многоточие (три точки 3)" }
  },
  "math": {
    "+": { "char": "⠐⠖", "dots": [4, 1, 2, 4], "description": "знак плюс" },
    "=": { "char": "⠐⠶", "dots": [4, 1, 2, 3, 6], "description": "знак равенства" },
    "/": { "char": "⠸⠌", "dots": [3, 4, 5, 3, 4], "description": "косая черта (прямой слэш)" },
    "%": { "char": "⠨⠴", "dots": [3, 5, 2, 3, 4], "description": "знак процента" },
    "@": { "char": "⠈⠁", "dots": [3, 0], "description": "коммерческий знак «собака» (@)" },
    "_": { "char": "⠨⠤", "dots": [3, 5, 2, 5], "description": "подчёркивание / нижнее подчёркивание" }
  }
}